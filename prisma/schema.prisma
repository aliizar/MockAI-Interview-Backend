generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum InterviewStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

enum QuestionType {
  TECHNICAL
  BEHAVIORAL
  SITUATIONAL
  FOLLOW_UP
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

model User {
  id                  Int                   @id @default(autoincrement())
  name                String
  email               String                @unique
  passwordHash        String
  emailVerified       Boolean               @default(false)

  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  interviewPreference InterviewPreference?
  chatConversations ChatConversation[]
  interviews          Interview[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewPreference {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique

  role              String   @default("No Role Selected!")
  difficulty        String   @default("Intermediate")
  interviewType     String   @default("Mixed")
  duration          Int      @default(30)

  rememberHistory   Boolean  @default(true)
  recommendations   Boolean  @default(true)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Interview {
  id            Int             @id @default(autoincrement())
  userId        Int
  role          String
  difficulty    String
  interviewType String
  duration      Int

  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  status        InterviewStatus @default(ACTIVE)

  overallScore  Float?
  feedback      Json?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions     InterviewQuestion[]
}

model InterviewQuestion {
  id             Int          @id @default(autoincrement())
  interviewId    Int

  questionNumber Int
  question       String
  type           QuestionType
  answer         String?

  score          Float?
  feedback       Json?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  interview      Interview    @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, questionNumber])
}


model ChatConversation {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}

model ChatMessage {
  id             Int             @id @default(autoincrement())
  conversationId Int
  role           ChatMessageRole
  content        String
  createdAt      DateTime        @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}